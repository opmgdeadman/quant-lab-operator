{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quant-lab-operator",
  "main": "src/index.js",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CURRENT_PHASE": "stage-1-truthful-data-foundation",
    "MARKET_DATA_PROVIDER": "coinbase_exchange",
    "DEPLOYMENT_SHA": "set-by-deploy-script",
    "REPOSITORY_SHA": "set-by-deploy-script",
    "MCP_CLIENT_ID": "quant-lab-dev",
    "GITHUB_OWNER": "opmgdeadman",
    "GITHUB_REPO": "quant-lab-operator",
    "GITHUB_BRANCH": "main",
    "GITHUB_DEPLOY_WORKFLOW_ID": "quant-lab-deploy.yml"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quant_lab_operator",
      "database_id": "d9ac1f46-8251-4184-ad35-b87be4755917",
      "migrations_dir": "migrations"
    }
  ]
}
